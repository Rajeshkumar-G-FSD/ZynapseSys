{
  "version": 2,
  "builds": [
    { "src": "**/*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/team", "dest": "/team.html" },
    { "src": "/careers", "dest": "/careers.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
